# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Telegram Bot API configurations for real-time Alert triggers
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Resend API key and email configurations for dynamic email dispatch
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
EMAIL_TO=""

# Optional CoinGecko API Key (Demo or Pro)
COINGECKO_API_KEY=""

# Optional Birdeye API Key
BIRDEYE_API_KEY=""

# Solana RPC and Token Creator Configuration
SOLANA_RPC_URL=""
SOLANA_NETWORK="mainnet-beta"
SURCHI_TOKEN_CREATION_FEE="0.1"
SURCHI_FEE_WALLET="7KiihM84H4T9gCLD61HpcRGtSapk9N2H3QAsn9A5y9Ng"
HELIUS_API_KEY=""

# Optional DEX API URL (custom proxy endpoint)
DEX_API_URL=""

# Custom Blockchain RPC Endpoints for Production Resiliency
ETHEREUM_RPC_URL=""
SOLANA_RPC_URL=""
BASE_RPC_URL=""
BNB_RPC_URL=""
POLYGON_RPC_URL=""
ARBITRUM_RPC_URL=""
OPTIMISM_RPC_URL=""
AVALANCHE_RPC_URL=""
SUI_RPC_URL=""
SEI_REST_URL=""
